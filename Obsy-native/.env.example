# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RevenueCat (OBS-19) — PUBLIC SDK keys, safe to ship in the client.
# Production keys are injected at build time from these EXACT env var names
# (set them as project-scoped EAS secrets:
#   eas secret:create --scope project --name EXPO_PUBLIC_REVENUECAT_IOS_KEY --value appl_...).
# When unset (local/dev), the app falls back to the board's TEST key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_ios_public_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_android_public_key

